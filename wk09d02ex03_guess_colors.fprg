<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="rainbowcolorsquiz_maverick_mesare"/>
        <attribute name="authors" value="maverick"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-10-01 10:35:20 AM"/>
